{
  "name": "realtime-chat",
  "version": "1.0.0",
  "scripts": {
    "start:client": "cd client && npm start",
    "start:server": "cd server && npm run dev",
    "dev": "concurrently --log-level debug \"npm run start:server\" \"npm run start:client\""

  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
